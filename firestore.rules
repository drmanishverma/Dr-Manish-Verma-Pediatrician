rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /patients/{patientId} {
      allow read, update: if request.auth != null && request.auth.uid == patientId;
      allow create: if request.auth != null;
      allow delete: if false;
      match /{subCollection=**}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == patientId;
      }
    }
    match /doctors/{doctorId} {
      allow read, write: if request.auth.token.role == "doctor";
    }
    match /education/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == "doctor";
    }
    match /dietPlans/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == "doctor";
    }
  }
}
